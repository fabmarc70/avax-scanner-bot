//@version=5
strategy("BTC SMC Trend Pullback V1", overlay=true, pyramiding=0, initial_capital=10000, commission_type=strategy.commission.percent, commission_value=0.06, calc_on_order_fills=true)

// === Inputs ===
emaFastLen = input.int(50, "EMA rapide", minval=1)
emaSlowLen = input.int(200, "EMA lente", minval=1)
rsiLen = input.int(14, "RSI length", minval=2)
rsiLongMin = input.float(45, "RSI long min", minval=0, maxval=100)
rsiLongMax = input.float(70, "RSI long max", minval=0, maxval=100)
rsiShortMin = input.float(30, "RSI short min", minval=0, maxval=100)
rsiShortMax = input.float(55, "RSI short max", minval=0, maxval=100)
atrLen = input.int(14, "ATR length", minval=1)
slAtrMult = input.float(1.5, "Multiplicateur SL ATR", minval=0.1, step=0.1)
tpRR = input.float(2.0, "Ratio TP", minval=0.1, step=0.1)
structureLookback = input.int(20, "Lookback structure", minval=2)
maxTradesPerDay = input.int(3, "Max trades par jour", minval=1, maxval=5)
riskPct = input.float(0.5, "Risque par trade (%)", minval=0.1, maxval=5, step=0.1)
enableLongs = input.bool(true, "Activer longs")
enableShorts = input.bool(true, "Activer shorts")
enableVolFilter = input.bool(true, "Activer filtre volatilité")
atrVolThresholdPct = input.float(0.15, "Seuil volatilité ATR%", minval=0.01, step=0.01)
pullbackAtrDistance = input.float(0.8, "Distance max à EMA50 (x ATR)", minval=0.1, step=0.1)

// === Indicators ===
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
rsi = ta.rsi(close, rsiLen)
atr = ta.atr(atrLen)
atrPct = atr / close * 100.0

// === Trade counter (daily) ===
newDay = ta.change(time("D")) != 0
var int tradesToday = 0
if newDay
    tradesToday := 0

tradeClosedOrOpened = strategy.position_size != strategy.position_size[1]
if tradeClosedOrOpened and strategy.position_size != 0
    tradesToday += 1

canTradeToday = tradesToday < maxTradesPerDay

// === Trend filters ===
bullTrend = close > emaSlow and emaFast > emaSlow
bearTrend = close < emaSlow and emaFast < emaSlow

// === Structure breakout (simplified BOS) ===
highestRecent = ta.highest(high[1], structureLookback)
lowestRecent = ta.lowest(low[1], structureLookback)
longBreak = close > highestRecent
shortBreak = close < lowestRecent

// === Pullback state machine ===
var bool longBreakArmed = false
var bool shortBreakArmed = false

if longBreak and bullTrend
    longBreakArmed := true
if shortBreak and bearTrend
    shortBreakArmed := true

// Cancel setups if trend invalidated
if close < emaSlow
    longBreakArmed := false
if close > emaSlow
    shortBreakArmed := false

longPullback = longBreakArmed and math.abs(close - emaFast) <= (pullbackAtrDistance * atr) and close >= emaSlow
shortPullback = shortBreakArmed and math.abs(close - emaFast) <= (pullbackAtrDistance * atr) and close <= emaSlow

// === Confirmation ===
longConfirm = close > open and close > close[1] and rsi >= rsiLongMin and rsi <= rsiLongMax
shortConfirm = close < open and close < close[1] and rsi >= rsiShortMin and rsi <= rsiShortMax

volatilityOk = not enableVolFilter or atrPct >= atrVolThresholdPct

longSignal = enableLongs and bullTrend and longPullback and longConfirm and volatilityOk and canTradeToday and strategy.position_size == 0
shortSignal = enableShorts and bearTrend and shortPullback and shortConfirm and volatilityOk and canTradeToday and strategy.position_size == 0

// === Position sizing by risk ===
riskValue = strategy.equity * (riskPct / 100.0)
slDistance = slAtrMult * atr
qty = slDistance > 0 ? riskValue / slDistance : 0

if longSignal and qty > 0
    strategy.entry("Long", strategy.long, qty=qty)
    longBreakArmed := false

if shortSignal and qty > 0
    strategy.entry("Short", strategy.short, qty=qty)
    shortBreakArmed := false

// === Exits ===
if strategy.position_size > 0
    longStop = strategy.position_avg_price - slDistance
    longTP = strategy.position_avg_price + (slDistance * tpRR)
    strategy.exit("Long Exit", "Long", stop=longStop, limit=longTP)

if strategy.position_size < 0
    shortStop = strategy.position_avg_price + slDistance
    shortTP = strategy.position_avg_price - (slDistance * tpRR)
    strategy.exit("Short Exit", "Short", stop=shortStop, limit=shortTP)

// === Visuals ===
plot(emaFast, "EMA 50", color=color.new(color.orange, 0), linewidth=2)
plot(emaSlow, "EMA 200", color=color.new(color.blue, 0), linewidth=2)
plotshape(longSignal, title="Signal Long", style=shape.triangleup, location=location.belowbar, color=color.new(color.green, 0), size=size.tiny, text="LONG")
plotshape(shortSignal, title="Signal Short", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0), size=size.tiny, text="SHORT")

// === Alerts ===
alertcondition(longSignal, title="BTC SMC V1 Long", message="BTC SMC Trend Pullback V1: Signal LONG")
alertcondition(shortSignal, title="BTC SMC V1 Short", message="BTC SMC Trend Pullback V1: Signal SHORT")

// Debug info
plotchar(tradesToday, title="Trades Today", char='•', location=location.bottom, color=color.new(color.gray, 70))
